rules_version = '2';

// Each saved project is a document at /users/{uid}/projects/{projectId}. A user can only
// read/write documents under their own uid — enforced here, not in client code.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/projects/{projectId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
